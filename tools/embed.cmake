# Embeds the files first-run setup needs into the program (src/runtime/setup.cpp): the headers the game module
# is compiled with, its glue, the game's names and the 8-rider build's overrides.
#   cmake -DOUT=<setup_files.inc> -DROOT=<source dir> -P tools/embed.cmake
set(_files
    "src/runtime/ctx.h|include/runtime/ctx.h"
    "src/runtime/modules.h|include/runtime/modules.h"
    "src/runtime/abi.h|include/runtime/abi.h"
    "src/game/glue.cpp|glue.cpp"
    "config/GKYE01/names.txt|names.txt"
    "config/GKYE01/patches_8p.txt|patches_8p.txt")
set(_text "// Generated by tools/embed.cmake at build time. Never edit.\n")
set(_table "static const EmbeddedFile kEmbedded[] = {\n")
set(_i 0)
foreach (_entry ${_files})
    string(REPLACE "|" ";" _parts "${_entry}")
    list(GET _parts 0 _src)
    list(GET _parts 1 _dst)
    file(READ "${ROOT}/${_src}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" _bytes "${_bytes}")
    string(APPEND _text "static const unsigned char kEmbed${_i}[] = {\n${_bytes}0};\n")
    string(APPEND _table "    {\"${_dst}\", kEmbed${_i}, ${_size}},\n")
    math(EXPR _i "${_i} + 1")
endforeach ()
string(APPEND _table "};\n")
file(WRITE "${OUT}.tmp" "${_text}${_table}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
