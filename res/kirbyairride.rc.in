// The program's Windows resources: what it is (version information) and how Windows runs it (its manifest). Configured by
// CMakeLists.txt with the project's version.
#include <winres.h>

1 RT_MANIFEST "@KAR_MANIFEST@"
1 ICON "@KAR_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kirby Air Ride: Recompiled project"
            VALUE "FileDescription", "Kirby Air Ride: Recompiled"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "kirbyairride"
            VALUE "LegalCopyright", "Kirby Air Ride: Recompiled contributors (PolyForm Noncommercial 1.0.0). Kirby Air Ride is (c) Nintendo / HAL Laboratory."
            VALUE "OriginalFilename", "kirbyairride.exe"
            VALUE "ProductName", "Kirby Air Ride: Recompiled"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "A native PC version of Kirby Air Ride, built from the player's own disc. https://github.com/sonsegajp/Kirby-Air-Ride-Recompiled"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
