+namespace {
+std::atomic_bool sWidescreen{false};
+
+// Where the current draws go on a target wider than the logical screen: stretched across it like
+// the plain mapping (wide perspective views, full-width 2D, texture passes), or kept at the
+// logical aspect and moved by dx logical units toward the edge they are near.
+struct WidePlacement {
+  bool stretch;
+  float dx;
+};
+WidePlacement wide_placement(float logicalWidth, const gfx::Viewport& viewport) noexcept {
+  const float w = widescreen_factor();
+  if (w <= 1.f || widescreen_expands()) {
+    return {true, 0.f};
+  }
+  int anchor = g_gxState.wide2D;
+  if (g_gxState.projType == GX_PERSPECTIVE) {  // a small 3D viewport (a HUD model): by its centre
+    const float cx = viewport.left + viewport.width * 0.5f;
+    anchor = cx < 0.3f * logicalWidth ? 1 : cx > 0.7f * logicalWidth ? 2 : 0;
+  }
+  if (anchor == 3) {
+    return {true, 0.f};
+  }
+  const float edge = (w - 1.f) * logicalWidth * 0.5f;
+  return {false, anchor == 1 ? -edge : anchor == 2 ? edge : 0.f};
+}
+} // namespace
+
+void set_widescreen(bool enabled) noexcept { sWidescreen.store(enabled, std::memory_order_release); }
+
+float widescreen_factor() noexcept {
+  if (!sWidescreen.load(std::memory_order_acquire) || g_gxState.wideSegment == 0 || gfx::is_offscreen() ||
+      g_gxState.viewportPolicy == AURORA_VIEWPORT_NATIVE) {
+    return 1.f;
+  }
+  const auto [logicalW, logicalH] = logical_fb_size();
+  const auto [targetW, targetH] = gfx::get_render_target_size();
+  if (logicalW == 0 || logicalH == 0 || targetW == 0 || targetH == 0) {
+    return 1.f;
+  }
+  const float w = (static_cast<float>(targetW) / static_cast<float>(targetH)) /
+                  (static_cast<float>(logicalW) / static_cast<float>(logicalH));
+  return w > 1.001f ? w : 1.f;
+}
+
+bool widescreen_expands() noexcept {
+  return widescreen_factor() > 1.f && g_gxState.projType == GX_PERSPECTIVE &&
+         g_gxState.logicalViewport.width >= 0.47f * static_cast<float>(logical_fb_size().x);
+}
