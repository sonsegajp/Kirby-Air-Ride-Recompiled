+// A session's mark on the pipeline cache (patches/aurora): made at start, removed at a clean exit
+// (aurora_pipeline_cache_clean_exit). Found at start, the last session crashed - perhaps building a pipeline the cache
+// had just recorded, which every later start would build again first and crash on as well (Kirby Air Ride: a draw
+// from a stream gone out of step) - so the cache is dropped and starts over.
+static unsigned long current_pid() {
+#if defined(_WIN32)
+  return GetCurrentProcessId();
+#else
+  return static_cast<unsigned long>(getpid());
+#endif
+}
+
+static std::filesystem::path pipeline_cache_mark() {
+  return io::fs_path_from_string(g_config.cachePath) / "pipeline_cache.in_use";
+}
+
+// The process that made a mark, if it is still running (a second copy of the game shares the cache).
+static bool mark_owner_running(const std::filesystem::path& mark) {
+  unsigned long pid = 0;
+  if (SDL_IOStream* f = SDL_IOFromFile(io::fs_path_to_string(mark).c_str(), "rb")) {
+    char buf[32] = {};
+    SDL_ReadIO(f, buf, sizeof buf - 1);
+    SDL_CloseIO(f);
+    pid = std::strtoul(buf[0] == 'o' && buf[1] == 'k' ? buf + 3 : buf, nullptr, 10);
+  }
+  if (pid == 0 || pid == static_cast<unsigned long>(current_pid())) {
+    return false;
+  }
+#if defined(_WIN32)
+  const HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, static_cast<DWORD>(pid));
+  if (h == nullptr) {
+    return false;
+  }
+  DWORD code = 0;
+  const bool running = GetExitCodeProcess(h, &code) && code == STILL_ACTIVE;
+  CloseHandle(h);
+  return running;
+#else
+  return kill(static_cast<pid_t>(pid), 0) == 0;
+#endif
+}
+
+static void check_pipeline_cache_mark() {
+  std::error_code ec;
+  const auto mark = pipeline_cache_mark();
+  if (std::filesystem::exists(mark, ec) && mark_owner_running(mark)) {
+    return;  // another copy is running: its mark stays
+  }
+  // Only a session that died in its first seconds (before aurora_pipeline_cache_session_ok marked it "ok") drops the
+  // cache: a pipeline the cache recorded that crashes as it is built crashes every start, at once. A session closed
+  // any other way (killed, crashed later) keeps the cache - starting over makes every level draw dark and slow for a
+  // while as its pipelines are built again.
+  bool healthy = false;
+  if (SDL_IOStream* f = SDL_IOFromFile(io::fs_path_to_string(mark).c_str(), "rb")) {
+    char buf[4] = {};
+    SDL_ReadIO(f, buf, 2);
+    SDL_CloseIO(f);
+    healthy = buf[0] == 'o' && buf[1] == 'k';
+  }
+  if (std::filesystem::exists(mark, ec) && healthy) {
+    Log.info("The last session did not exit cleanly (after it ran fine): the pipeline cache is kept");
+  } else if (std::filesystem::exists(mark, ec)) {
+    Log.warn("The last session ended in its first seconds: the pipeline cache starts over");
+    const auto dir = io::fs_path_from_string(g_config.cachePath);
+    for (const char* name : {"pipeline_cache.db", "pipeline_cache.db-wal", "pipeline_cache.db-shm"}) {
+      std::filesystem::remove(dir / name, ec);
+    }
+  }
+  if (SDL_IOStream* f = SDL_IOFromFile(io::fs_path_to_string(mark).c_str(), "wb")) {
+    const auto pid = std::to_string(current_pid());
+    SDL_WriteIO(f, pid.data(), pid.size());
+    SDL_CloseIO(f);
+  }
+}
+
 void initialize_pipeline_cache() {
+  check_pipeline_cache_mark();
   g_pipelineCacheBroken = false;
   g_pipelineCacheWriterStop = false;
   g_pipelineThreadEnd = false;
@@ -1211,3 +1296,23 @@ bool get_pipeline(PipelineRef ref, CompiledPipeline& pipeline) {
 }
 
 } // namespace aurora::gfx
+
+// The host is exiting cleanly (it may leave without Aurora's shutdown): the pipeline cache is good.
+// The host: this session has run long enough (its start did not crash): the mark says so.
+extern "C" void aurora_pipeline_cache_session_ok() {
+  const auto mark = aurora::gfx::pipeline_cache_mark();
+  if (SDL_IOStream* f = SDL_IOFromFile(aurora::io::fs_path_to_string(mark).c_str(), "wb")) {
+    const auto text = "ok " + std::to_string(aurora::gfx::current_pid());
+    SDL_WriteIO(f, text.data(), text.size());
+    SDL_CloseIO(f);
+  }
+}
+
+extern "C" void aurora_pipeline_cache_clean_exit() {
+  const auto mark = aurora::gfx::pipeline_cache_mark();
+  if (aurora::gfx::mark_owner_running(mark)) {
+    return;  // (another copy's)
+  }
+  std::error_code ec;
+  std::filesystem::remove(mark, ec);
+}
