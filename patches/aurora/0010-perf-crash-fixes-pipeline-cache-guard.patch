+// Content hashes of textures without an object id (a raw GX stream's: every load is by address), kept for one game
+// frame: the renderer draws several in-between frames from each, all loading the same textures, and hashing every
+// texture's bytes again each time cost milliseconds a frame in busy scenes. The host starts a new memo with each game
+// frame (aurora_texture_memo_reset); until then a texture at the same address, size, format and palette is the same.
+struct HashMemoKey {
+  const void* data;
+  const void* tlut;
+  u32 width, height, format, mips;
+  u32 tlutFormat, tlutEntries;
+  bool sourceKey;
+  bool operator==(const HashMemoKey&) const = default;
+  template <typename H>
+  friend H AbslHashValue(H h, const HashMemoKey& k) {
+    return H::combine(std::move(h), k.data, k.tlut, k.width, k.height, k.format, k.mips, k.tlutFormat, k.tlutEntries,
+                      k.sourceKey);
+  }
+};
+absl::flat_hash_map<HashMemoKey, TextureKeys> s_hashMemo;
+std::atomic<uint32_t> s_hashMemoGeneration{0};
+uint32_t s_hashMemoSeen = 0;
+
+TextureKeys hash_texture_source(const GXTexObj_& obj, const GXTlutObj_* tlut, bool buildSourceKey) {
+  if (obj.texObjId != 0) {
+    return hash_texture_source_uncached(obj, tlut, buildSourceKey);
+  }
+  if (const uint32_t gen = s_hashMemoGeneration.load(std::memory_order_acquire); gen != s_hashMemoSeen) {
+    s_hashMemoSeen = gen;
+    s_hashMemo.clear();
+  }
+  const HashMemoKey key{
+      .data = obj.data,
+      .tlut = tlut != nullptr ? tlut->data : nullptr,
+      .width = obj.width(),
+      .height = obj.height(),
+      .format = static_cast<u32>(obj.format()),
+      .mips = obj.mip_count(),
+      .tlutFormat = tlut != nullptr ? static_cast<u32>(tlut->format) : 0u,
+      .tlutEntries = tlut != nullptr ? static_cast<u32>(tlut->numEntries) : 0u,
+      .sourceKey = buildSourceKey,
+  };
+  if (const auto it = s_hashMemo.find(key); it != s_hashMemo.end()) {
+    return it->second;
+  }
+  TextureKeys keys = hash_texture_source_uncached(obj, tlut, buildSourceKey);
+  if (s_hashMemo.size() >= 16384) {
+    s_hashMemo.clear();
+  }
+  s_hashMemo.emplace(key, keys);
+  return keys;
+}
